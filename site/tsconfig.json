{
    "compilerOptions": {
        "target": "ES2024",
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "types": [
            "vite/client",
            "node"
        ],
        "paths": {
            "@src/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src",
        "vite.config.ts"
    ]
}